<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0-windows7.0</TargetFramework>
		<RootNamespace>Titled_Gui</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PlatformTarget>x64</PlatformTarget>
		<UseWindowsForms>true</UseWindowsForms>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Platforms>AnyCPU;x64</Platforms>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<AssemblyName>Titled GUI</AssemblyName>
		<SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
		<ApplicationIcon>MenuLogo.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Configs\**" />
		<EmbeddedResource Remove="Configs\**" />
		<None Remove="Configs\**" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Resources\sounds\ClickSounds\Creamy.wav" />
		<None Remove="Resources\fonts\NotoSans-BoldIcons.ttf" />
		<None Remove="Resources\fonts\undefeated.ttf" />
		<None Remove="Resources\MenuLogo.png" />
		<None Remove="Resources\sounds\hitsounds\CODHitmarker.wav" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="MenuLogo.ico" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Resources\sounds\hitsounds\CODHitmarker.wav">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\fonts\NotoSans-BoldIcons.ttf">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</EmbeddedResource>
		<EmbeddedResource Include="Resources\MenuLogo.png">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</EmbeddedResource>
		<EmbeddedResource Include="Resources\sounds\hitsounds\NeverLose.wav">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</EmbeddedResource>
		<EmbeddedResource Include="Resources\sounds\hitsounds\Skeet.wav">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ClickableTransparentOverlay" Version="9.1.0" />
		<PackageReference Include="DiscordRichPresence" Version="1.5.0.51" />
		<PackageReference Include="NAudio" Version="2.3.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="SharpGLTF.Core" Version="1.0.6" />
		<PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
		<PackageReference Include="ValveResourceFormat" Version="19.2.6339" />
		<PackageReference Include="VCollab.DiscordRichPresence" Version="1.7.0" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\fonts\undefeated.ttf">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\sounds\ClickSounds\Creamy.wav">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</EmbeddedResource>
	</ItemGroup>

</Project>
